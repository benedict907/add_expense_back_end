# Shared secret the iPhone shortcut sends as the X-API-Key header.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
QUICK_EXPENSE_API_KEY=

# Realtime Database URL (same value as VITE_FIREBASE_DATABASE_URL in the front end)
FIREBASE_DATABASE_URL=https://expense-manager-66383-default-rtdb.asia-southeast1.firebasedatabase.app

# Top-level key your data lives under in the Realtime Database.
# The front end uses the signed-in phone number with spaces stripped, e.g. +919876543210
EXPENSE_DATA_ROOT=

# Firebase Console -> Project settings -> Service accounts -> Generate new private key.
# Paste the full downloaded JSON file content here as one line (deployment),
# or use FIREBASE_SERVICE_ACCOUNT_FILE to point at a local file path instead.
FIREBASE_SERVICE_ACCOUNT_JSON=

EXPENSE_TIMEZONE=Asia/Kolkata
