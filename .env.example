# Shared secret the iPhone shortcut sends as the X-API-Key header.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
QUICK_EXPENSE_API_KEY=

# Realtime Database URL (same value as VITE_FIREBASE_DATABASE_URL in the front end)
FIREBASE_DATABASE_URL=https://expense-manager-66383-default-rtdb.asia-southeast1.firebasedatabase.app

# Top-level key your data lives under in the Realtime Database.
# The front end uses the signed-in phone number with spaces stripped, e.g. +919876543210
EXPENSE_DATA_ROOT=

# Firebase Console -> Project settings -> Service accounts -> Generate new private key.
# Paste the full downloaded JSON file content here as one line (deployment),
# or use FIREBASE_SERVICE_ACCOUNT_FILE to point at a local file path instead.
FIREBASE_SERVICE_ACCOUNT_JSON=

EXPENSE_TIMEZONE=Asia/Kolkata

# Extra words that route dictated text to a category, added without a redeploy.
# Merged on top of CATEGORY_KEYWORDS in expense_text.py; anything still
# unmatched falls back to Miscellaneous. Categories must be spelled exactly as
# in the front end: Groceries, Food & Dining, Transport, Bills & Utilities,
# Shopping, Health, Entertainment, Miscellaneous.
# EXPENSE_CATEGORY_KEYWORDS={"Health": ["ayurveda"], "Food & Dining": ["thattukada"]}


# ============================================================
# Credit-card statement module
# ============================================================

# --- Gmail (read-only) ---
# Google Cloud Console -> enable Gmail API -> OAuth consent screen (External,
# add yourself as a Test user) -> Credentials -> OAuth client ID -> Desktop app.
# Then run once:  python tools/gmail_oauth_setup.py
# It prints all three values below.
# This file is committed to git — keep every value blank here.
# Real values go in .env (git-ignored) and in your host's env vars.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# --- Statement PDF passwords ---
# One variable per card. The NAME of the variable goes in creditcards/cards.json
# as "passwordEnv"; the password itself only ever lives here (or in your host's
# env vars). Never commit these, and never put them in the Realtime Database.
CC_PASSWORD_KOTAK=
CC_PASSWORD_ICICI_AMAZON=
CC_PASSWORD_ICICI_SAPPHIRO=
CC_PASSWORD_HDFC_SWIGGY=
CC_PASSWORD_SBI=

# --- Card config ---
# Defaults to creditcards/cards.json (git-ignored). On hosts with no writable
# filesystem, paste the whole JSON into CREDIT_CARDS_CONFIG_JSON instead.
# CREDIT_CARDS_CONFIG_FILE=creditcards/cards.json
# CREDIT_CARDS_CONFIG_JSON=

# --- API auth ---
# The browser authenticates with its Firebase ID token, so no key is needed for
# the dashboard. Set this only if you also want to call the endpoints from a
# script or cron job with an X-API-Key header.
CREDIT_CARD_API_KEY=

# OCR fallback resolution for scanned statements (needs tesseract + poppler).
# CC_OCR_DPI=300
