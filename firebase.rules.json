{
  "_comment": [
    "Realtime Database rules covering the credit-card and loans namespaces.",
    "Paste into Firebase Console -> Realtime Database -> Rules, merging with any",
    "rules you already have. The pattern is: a signed-in user can only touch the",
    "node whose key is their own phone number (the dataRoot the front end uses).",
    "The backend uses the Admin SDK, which bypasses these rules by design."
  ],
  "rules": {
    "$dataRoot": {
      ".read": "auth != null && ($dataRoot === auth.token.phone_number.replace(' ', '') || $dataRoot === auth.uid)",
      ".write": "auth != null && ($dataRoot === auth.token.phone_number.replace(' ', '') || $dataRoot === auth.uid)",

      "creditCards": {
        ".indexOn": ["active"]
      },
      "creditCardStatements": {
        ".indexOn": ["cardId", "statementMonth"]
      },
      "creditCardTransactions": {
        "$statementId": {
          ".indexOn": ["cardId", "ownerId", "transactionDate", "transactionType"]
        }
      },
      "loans": {
        ".indexOn": ["status"],
        "$loanId": {
          ".validate": "newData.hasChildren(['name', 'amount', 'lentOn', 'status'])",
          "name": { ".validate": "newData.isString() && newData.val().length > 0" },
          "amount": { ".validate": "newData.isNumber() && newData.val() > 0" },
          "lentOn": { ".validate": "newData.isString()" },
          "status": { ".validate": "newData.val() === 'active' || newData.val() === 'closed'" },
          "closedOn": { ".validate": "newData.isString()" },
          "repayments": {
            "$repaymentId": {
              ".validate": "newData.hasChildren(['amount', 'date']) && newData.child('amount').isNumber() && newData.child('amount').val() > 0"
            }
          }
        }
      },
      "creditCardOwnerRules": {
        ".read": "auth != null && ($dataRoot === auth.token.phone_number.replace(' ', '') || $dataRoot === auth.uid)"
      }
    }
  }
}
